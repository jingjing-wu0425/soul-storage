generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  displayName  String?
  avatarUrl    String?
  bio          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  entries      Entry[]
}

model Entry {
  id           String   @id @default(cuid())
  userId       String
  title        String?
  content      String
  excerpt      String?

  mood         Int?
  location     String?
  ambientSound String?
  weather      String?

  visibility   String   @default("private")
  status       String   @default("draft")

  entryDate    DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  images       EntryImage[]
  musicAnchors MusicAnchor[]

  @@index([userId])
  @@index([visibility])
  @@index([entryDate])
}

model EntryImage {
  id        String   @id @default(cuid())
  entryId   String
  url       String
  caption   String?
  order     Int      @default(0)
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  entry     Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
}

model MusicAnchor {
  id          String   @id @default(cuid())
  entryId     String
  trackName   String
  artist      String?
  albumArtUrl String?
  sourceUrl   String?
  createdAt   DateTime @default(now())

  entry       Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
}

model ExperienceEntry {
  id           String   @id @default(cuid())
  sectionId    String
  sectionNum   String
  sectionLabel String
  date         String   @default("")
  title        String   @default("")
  subtitle     String   @default("")
  tags         String   @default("")
  detail       String   @default("")
  pending      Boolean  @default(false)
  placeholder  Boolean  @default(false)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([sectionId])
  @@index([order])
}
